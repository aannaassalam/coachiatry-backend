# Essential Database Configuration
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@cluster1.dvfjtgc.mongodb.net/<DB_NAME>?retryWrites=true&w=majority&appName=Cluster1
DATABASE_PASSWORD=PASSWORD

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-should-be-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Server Configuration
NODE_ENV=development
PORT=3001

# Azure Communication Services Email Configuration (Primary)
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
AZURE_SENDER_EMAIL=DoNotReply@your-verified-domain.azurecomm.net
ADMIN_EMAIL=admin@yourdomain.com

# NodeMailer Fallback Configuration (Backup)
EMAIL_HOST=smtp.gmail.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_PORT=587

# SMS Configuration (MSG91)
MSG91_AUTH_KEY=your-msg91-auth-key
